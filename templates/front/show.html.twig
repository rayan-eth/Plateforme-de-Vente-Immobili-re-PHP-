{% extends 'base.html.twig' %}

{% block title %}{{ listing.title }} | EstateSphere{% endblock %}

{% block body %}
{# --- Header for uniformity --- #}
<div style="background-color: #121212; padding: 20px 50px; border-bottom: 1px solid #333;" class="d-flex justify-content-between align-items-center">
    <div class="text-white font-weight-bold" style="font-family: 'Playfair Display'; font-size: 1.5rem;">
        ESTATE<span style="color: #D4AF37;">SPHERE</span>
    </div>
    <a href="{{ path('app_homepage') }}" class="text-white" style="text-decoration: none; letter-spacing: 1px; font-size: 0.8rem;"><i class="fas fa-arrow-left"></i> BACK TO COLLECTION</a>
</div>

<div class="container mt-5 mb-5">
    <div class="row">
        {# Image Section #}
        <div class="col-lg-8">
            <div style="border: 1px solid #333; padding: 10px;">
                <img src="{{ listing.image|default('https://images.unsplash.com/photo-1613490493576-7fde63acd811?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80') }}" class="img-fluid w-100" alt="{{ listing.title }}" style="object-fit: cover; height: 500px;">
            </div>
            
            <div class="mt-5">
                <h1 style="color: #fff; font-size: 3.5rem; margin-bottom: 10px;">{{ listing.title }}</h1>
                <p style="color: #D4AF37; font-size: 1.2rem; letter-spacing: 1px; text-transform: uppercase;"><i class="fas fa-map-marker-alt"></i> {{ listing.location }}</p>
                
                <hr style="border-color: #333; margin: 30px 0;">
                
                <h3 style="color: #fff; margin-bottom: 20px;">The Residence</h3>
                <p style="color: #aaa; line-height: 1.8; font-size: 1.05rem;">
                    {{ listing.description|nl2br }}
                </p>
                
                <div class="row mt-5">
                    <div class="col-md-6">
                        <div style="background: #1e1e1e; padding: 20px; border-left: 3px solid #D4AF37;">
                            <h5 style="color: #fff;">Accommodation</h5>
                            <span style="color: #aaa;">This property comfortably hosts <strong>{{ listing.capacity }}</strong> guests.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        {# Booking Sidebar #}
        <div class="col-lg-4">
            <div class="booking-card" style="background: #1e1e1e; padding: 40px; position: sticky; top: 100px; border: 1px solid #333;">
                <div class="price-tag" style="text-align: center; margin-bottom: 30px;">
                    <span style="color: #aaa; text-transform: uppercase; letter-spacing: 2px; font-size: 0.8rem;">Price per Night</span>
                    <h2 style="color: #D4AF37; font-size: 3rem; margin: 10px 0;">${{ listing.price|number_format }}</h2>
                </div>
                    <div class="form-group mb-4">
                        <label style="color: #fff; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 1px;">Arrival</label>
                        <input type="date" class="form-control" style="background: #121212; border: 1px solid #333; color: #fff; border-radius: 0; padding: 20px;">
                    </div>
                    <div class="form-group mb-4">
                        <label style="color: #fff; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 1px;">Departure</label>
                        <input type="date" class="form-control" style="background: #121212; border: 1px solid #333; color: #fff; border-radius: 0; padding: 20px;">
                    </div>
                    <button class="btn btn-luxury w-100" type="button" onclick="alert('Concierge service will contact you shortly.')">Request Reservation</button>
                    <p class="text-center mt-3" style="color: #555; font-size: 0.8rem;">Exclusive concierge service included.</p>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
