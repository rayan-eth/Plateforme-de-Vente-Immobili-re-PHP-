{% extends 'base.html.twig' %}

{% block title %}EstateSphere | Admin Login{% endblock %}

{% block body_class %}admin-login-page{% endblock %}

{% block body %}
    <div class="login-container">
        <div class="login-header">
            <div class="login-logo">
                <h1><span>Estate</span>Sphere</h1>
                <p class="login-subtitle">ADMIN PORTAL</p>
            </div>
        </div>

        <div class="login-card">
            <div class="login-icon">
                <i class="fas fa-lock"></i>
            </div>
            
            <h2>Administrator Access</h2>
            <p class="login-description">Enter your credentials to access the admin panel</p>
            
            <form method="post" class="login-form">
                {% if error %}
                    <div class="alert alert-danger text-center mb-4" style="background: rgba(220, 53, 69, 0.1); border: 1px solid #dc3545; color: #dc3545; padding: 10px;">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                <div class="form-group">
                    <label for="inputEmail">
                        <i class="fas fa-user"></i> Email
                    </label>
                    <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" placeholder="Enter admin email" required autofocus>
                </div>
                
                <div class="form-group">
                    <label for="inputPassword">
                        <i class="fas fa-key"></i> Password
                    </label>
                    <input type="password" name="_password" id="inputPassword" placeholder="Enter your password" required>
                </div>
                
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="login-btn">
                    <i class="fas fa-sign-in-alt"></i> SIGN IN
                </button>
                
                <div class="login-footer text-center mt-3">
                    <p style="color: #666; font-size: 0.8rem;">Need help? <a href="#" style="color: #d4af37;">Contact Support</a> or <a href="{{ path('app_register') }}" style="color: #d4af37;">Register</a></p>
                </div>
            </form>
        </div>
        
        <div class="login-security">
            <p><i class="fas fa-shield-alt"></i> Secure connection • Encrypted transmission</p>
        </div>
    </div>
{% endblock %}
